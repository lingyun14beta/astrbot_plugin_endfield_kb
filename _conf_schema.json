{
  "index_dir": {
    "description": "索引目录",
    "hint": "留空则使用 AstrBot 默认的 data/plugin_data/astrbot_plugin_endfield_kb/index。Docker 或只读部署可指向挂载卷里的目录。",
    "type": "string",
    "default": ""
  },
  "custom_sources": {
    "description": "自定义下载源",
    "hint": "关闭时只用内置的 GitHub + ModelScope 地址；开启后下面两个列表才会出现，并优先使用你填的地址（留空仍回退到内置地址）。",
    "type": "bool",
    "default": false
  },
  "manifest_urls": {
    "description": "更新清单地址",
    "hint": "每行一个，按顺序尝试；全部失败时再直接下载索引。",
    "type": "list",
    "condition": {
      "custom_sources": true
    },
    "default": []
  },
  "index_urls": {
    "description": "索引下载地址",
    "hint": "清单不可用时直接下载这些 zip，每行一个。",
    "type": "list",
    "condition": {
      "custom_sources": true
    },
    "default": []
  },
  "rewrite_provider": {
    "description": "关键词改写模型",
    "hint": "控制台勾选「关键词改写」时用它压缩描述；留空则用当前会话的模型。LLM 工具调用不会改写，直接检索。",
    "type": "string",
    "_special": "select_provider",
    "default": ""
  },
  "top_k": {
    "description": "默认返回条数",
    "hint": "模型没有指定 top_k 时使用，范围 1-10。",
    "type": "int",
    "default": 5
  },
  "max_chars": {
    "description": "单次返回字数上限",
    "hint": "返回给模型的正文总长度上限，越大上下文占用越高。",
    "type": "int",
    "default": 1800
  },
  "score_ratio": {
    "description": "相关度阈值（百分比）",
    "hint": "BM25 分数相对最佳结果的保留比例。越小越严格，只保留明显更相关的条目；越大召回越多。建议 40-60。",
    "type": "int",
    "default": 45
  },
  "rewrite_timeout": {
    "description": "关键词改写超时（秒）",
    "hint": "超过该时间未返回就放弃改写，直接用原始查询检索。",
    "type": "int",
    "default": 12
  },
  "notify_group": {
    "description": "版本推送",
    "hint": "定时查询终末地正式版与预下载版本，有变化时推送到下面列出的会话。与索引更新无关，推送失败也不影响检索。",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用推送",
        "hint": "关闭后不再查询版本，也不再发送任何通知。",
        "type": "bool",
        "default": true
      },
      "interval": {
        "description": "检查间隔（分钟）",
        "hint": "最小 5 分钟。版本以天为单位变化，不需要查得太密。",
        "type": "int",
        "default": 60
      },
      "pre_download": {
        "description": "通知预下载",
        "hint": "预下载开放与关闭时也推送；关闭后只推正式版本更新。",
        "type": "bool",
        "default": true
      },
      "umos": {
        "description": "推送会话",
        "hint": "每行一个 UMO，例如 aiocqhttp:GroupMessage:123456。管理员也可以用 /zmd订阅 让插件自动写入。",
        "type": "list",
        "default": []
      }
    }
  },
  "semantic_group": {
    "description": "语义检索（可选）",
    "hint": "用嵌入模型补充字面检索：查询先编码成向量，与 BM25 结果按 RRF 融合。需要先运行 /zmd向量 构建；未构建或调用失败时自动只用 BM25。",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用语义检索",
        "hint": "开启后每次检索多一次查询编码调用；未构建向量或调用失败时不会增加等待。",
        "type": "bool",
        "default": false
      },
      "provider": {
        "description": "嵌入模型 id",
        "hint": "留空用第一个可用的 embedding 模型；/zmd向量状态 会列出所有可选 id。",
        "type": "string",
        "default": ""
      },
      "weight": {
        "description": "向量权重（百分比）",
        "hint": "融合时向量那一路的相对权重，100 表示与 BM25 等权。",
        "type": "int",
        "default": 100
      },
      "candidates": {
        "description": "向量召回条数",
        "hint": "先取这么多向量近邻，再与 BM25 融合排序；越大越慢。",
        "type": "int",
        "default": 30
      }
    }
  },
  "t2i_group": {
    "description": "检索结果出图",
    "hint": "开启后 /zmd 的查询结果渲染成 720 宽的图片；渲染失败会自动退回文本。卡片内容会发送到 AstrBot 配置的 T2I 服务（默认官方端点），/zmd文字 始终返回文本。",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用出图",
        "hint": "只影响 /zmd 查询；状态类指令不受影响。",
        "type": "bool",
        "default": false
      },
      "theme": {
        "description": "卡片主题",
        "hint": "自动 = 按服务器本地时间在浅色与深色之间切换。",
        "type": "string",
        "options": ["light", "dark", "auto"],
        "labels": ["浅色", "深色", "自动"],
        "default": "auto",
        "condition": {
          "enable": true
        }
      },
      "dark_from": {
        "description": "夜间开始",
        "hint": "HH:MM，到这个时间之后用深色；默认 19:00。",
        "type": "string",
        "default": "19:00",
        "condition": {
          "enable": true,
          "theme": "auto"
        }
      },
      "dark_to": {
        "description": "夜间结束",
        "hint": "HH:MM，到这个时间切回浅色；默认 07:00。",
        "type": "string",
        "default": "07:00",
        "condition": {
          "enable": true,
          "theme": "auto"
        }
      },
      "max_hits": {
        "description": "结果条数",
        "hint": "1-8，默认 5；条数越多图越高。",
        "type": "int",
        "default": 5,
        "slider": {
          "min": 1,
          "max": 8,
          "step": 1
        },
        "condition": {
          "enable": true
        }
      },
      "excerpt_chars": {
        "description": "每条摘要字数上限",
        "hint": "默认 500；语料平均每篇约 210 字，多数条目会展示全文。",
        "type": "int",
        "default": 500,
        "slider": {
          "min": 500,
          "max": 2000,
          "step": 100
        },
        "condition": {
          "enable": true
        }
      },
      "timeout": {
        "description": "渲染超时（秒）",
        "hint": "超过后放弃出图，直接返回文本。",
        "type": "int",
        "default": 20,
        "slider": {
          "min": 5,
          "max": 60,
          "step": 5
        },
        "condition": {
          "enable": true
        }
      }
    }
  }
}
